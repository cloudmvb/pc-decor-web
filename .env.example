# ============================================================================
# SKYCRUMB STUDIO — DATABASE CONFIGURATION (.env.example)
# Sao chép file này thành ".env" để cấu hình kết nối CSDL khi khởi chạy server.
# ============================================================================

# Chọn engine CSDL:
#   - mssql  : Dùng Microsoft SQL Server 2022 Express (mặc định dự án, driver node-mssql + database/schema.sqlserver.sql)
#   - sqlite : Dùng SQLite cục bộ (database/skycrumb_erp.db) làm bản dự phòng
DB_CLIENT=mssql

# Cấu hình kết nối Microsoft SQL Server (SQLEXPRESS đã ghim cổng tĩnh TCP 1433)
MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_INSTANCE=
MSSQL_DATABASE=SkyCrumbERP
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Passw0rd
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Tự động tạo Database nếu chưa tồn tại trên SQL Server (1 = bật, 0 = tắt)
MSSQL_AUTO_CREATE_DB=1
